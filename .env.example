# Local CLI only. On GitHub configure these under Settings > Secrets > Actions.
# Supply ONE RTT next-generation token type. Never prefix secrets NEXT_PUBLIC_.
RTT_ACCESS_TOKEN=""
RTT_REFRESH_TOKEN=""
RTT_API_VERSION="2026-07-25"
# Optional path for persistent ingestion files. Ignored by Git by default.
DATA_DIR="data-store"
# GitHub Pages project path, e.g. /delayrepay. This value is public, not a secret.
NEXT_PUBLIC_BASE_PATH=""
