# Copy this file to .env for local RTT collection.
# Put exactly one token value in .env. Do not commit real tokens.

# Short-lived access token, if you already have one.
RTT_ACCESS_TOKEN=

# Refresh token from the RTT API portal. Preferred for local runs.
RTT_REFRESH_TOKEN=your_rtt_refresh_token_here

# Current RTT API version used by the client.
RTT_API_VERSION=2026-07-25

# Throttle live RTT calls. Increase these if you hit rate limits.
RTT_MIN_INTERVAL_MS=1500
RTT_RATE_LIMIT_WAIT_MS=10000
RTT_REQUEST_TIMEOUT_MS=15000

# Local data paths.
DATA_DIR=data-store

# Local dashboard listener. Windows exposes this as port 8787 on the home LAN.
DELAYREPAY_HOST=127.0.0.1
DELAYREPAY_PORT=8765
