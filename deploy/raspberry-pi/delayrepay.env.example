# Copy to the repository root as .env and fill in the secrets.
RTT_ACCESS_TOKEN=
RTT_REFRESH_TOKEN=
RTT_API_VERSION=2026-07-25
RTT_MIN_INTERVAL_MS=2000
RTT_RATE_LIMIT_RETRIES=5
RTT_RATE_LIMIT_WAIT_MS=15000
RTT_RATE_LIMIT_MAX_WAIT_MS=120000
RTT_REQUEST_TIMEOUT_MS=15000

# Runtime data is kept outside Git on the Pi.
DATA_DIR=/var/lib/delayrepay
DELAYREPAY_LOG_DIR=/var/lib/delayrepay/logs
DELAYREPAY_HOST=0.0.0.0
DELAYREPAY_PORT=8765

# Saturday Gmail summary.
DELAYREPAY_EMAIL_TO=Mitzbhakta@gmail.com
GMAIL_SMTP_USER=Mitzbhakta@gmail.com
GMAIL_APP_PASSWORD=
DELAYREPAY_DASHBOARD_URL=http://delayrepay.local:8765

# Read-only Gmail OAuth claim reconciliation. Copy both files to the Pi and
# keep them outside Git. Authorize once on a computer with a browser.
GMAIL_OAUTH_CLIENT_FILE=/var/lib/delayrepay/secrets/gmail-oauth-client.json
GMAIL_OAUTH_TOKEN_FILE=/var/lib/delayrepay/secrets/gmail-oauth-token.json
